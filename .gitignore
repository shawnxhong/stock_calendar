.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hermes/
runtime/

# Runtime state and generated reports
financial-calendar/data/*.json
financial-calendar/data/snapshots/*.json
financial-calendar/logs/*.md
financial-calendar/im-delivery/
financial-calendar/config/release_ids.yaml
financial-calendar/config/events_review.yaml

# Keep empty runtime directories in source control
!financial-calendar/data/.gitkeep
!financial-calendar/data/snapshots/.gitkeep
!financial-calendar/logs/.gitkeep
